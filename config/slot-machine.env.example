# slot-machine settings.
#   config/slot-machine.env.example  this template: which settings exist and what they mean (committed)
#   config/slot-machine.env          your values (git-ignored, chmod 600). `make config` creates it
#                                    from this template and refreshes it when the template changes.
# `make push-config` (or `make deploy`) uploads your values to the Pi as
# ~/.config/slot-machine/slot-machine.env. Other locations: --config PATH or SLOT_MACHINE_CONFIG=PATH.
# Add new settings and their comments here, not in your local copy: `make config` keeps only values.

# --- Appointment site --------------------------------------------------------
# Kazakhstan's site locale: en-kz, ru-kz or kk-kz (only changes the page language)
AIS_LOCALE=en-kz
# From the URL after you sign in and click Continue: .../niv/schedule/<THIS>/continue_actions
AIS_SCHEDULE_ID=
# Astana's location number. DevTools -> Network on the Reschedule page, pick Astana,
# read it from .../appointment/days/<THIS>.json   (or: slot-machine --discover)
AIS_FACILITY_ID=
# Name used in the messages
LOCATION_LABEL=Astana

# --- Telegram ----------------------------------------------------------------
# @BotFather -> /newbot gives the token. Message your bot once, then run --find-chat-id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- When to tell you ---------------------------------------------------------
# Daily summary: first run at or after this hour (0-23) in TIMEZONE. 1 = no sound.
DIGEST_HOUR=9
TIMEZONE=America/Los_Angeles
DIGEST_SILENT=1
# Optional: only alert immediately for dates before this one (YYYY-MM-DD), e.g. your
# currently booked appointment or the last date that still works. Empty = any sooner date.
ALERT_ONLY_BEFORE=

# --- Guard rails ---------------------------------------------------------------
# Refuse to check more often than this, even if cron fires more often.
MIN_INTERVAL_MINUTES=30
# Pause this long after an empty answer or HTTP 403/429 (the site may be throttling).
BACKOFF_HOURS=3
# Alert after this many failed checks in a row.
ERROR_ALERT_AFTER=3

# Use the same User-Agent as the browser you signed in with
# (browser DevTools console: navigator.userAgent). Empty = a generic Chrome string.
USER_AGENT=

# --- Files ---------------------------------------------------------------------
# Where state.json and cookies.json live. Empty = ~/.local/state/slot-machine
STATE_DIR=
