# slot-machine settings.
#   config/slot-machine.env.example  this template: which settings exist and what they mean (committed)
#   config/slot-machine.env          your values (git-ignored, chmod 600). `make config` creates it
#                                    from this template and refreshes it when the template changes.
# `make push-config` (or `make deploy`) uploads your values to the Pi as
# ~/.config/slot-machine/slot-machine.env. Other locations: --config PATH or SLOT_MACHINE_CONFIG=PATH.
# Add new settings and their comments here, not in your local copy: `make config` keeps only values.

# --- Appointment site --------------------------------------------------------
# Kazakhstan's site locale: en-kz, ru-kz or kk-kz (only changes the page language)
AIS_LOCALE=en-kz
# From the URL after you sign in and click Continue: .../niv/schedule/<THIS>/continue_actions
AIS_SCHEDULE_ID=
# Astana's location number. DevTools -> Network on the Reschedule page, pick Astana,
# read it from .../appointment/days/<THIS>.json   (or: slot-machine --discover)
AIS_FACILITY_ID=
# Name used in the messages
LOCATION_LABEL=Astana

# --- Telegram ----------------------------------------------------------------
# @BotFather -> /newbot gives the token. Message your bot once, then run --find-chat-id.
TELEGRAM_BOT_TOKEN=
# One or more chat ids, comma-separated. Everyone gets the date alerts and the daily summary;
# the FIRST chat (yours) also gets the housekeeping alerts (session ended, checks failing).
# Only chats listed here get messages. To add someone: they send the bot any message (/start),
# `make find-chat-id` shows their id, add it here and `make push-config`. On its next check the
# watch sends each newly added chat a welcome message with the current earliest date.
TELEGRAM_CHAT_ID=
# /check in any of those chats runs a check right away, like `make check-now` (it skips
# MIN_INTERVAL_MINUTES and any pause). This is the shortest gap allowed between two /check runs.
TELEGRAM_CHECK_COOLDOWN_MINUTES=2

# --- When to tell you ---------------------------------------------------------
# Daily summary: first run at or after this hour (0-23) in TIMEZONE. 1 = no sound.
DIGEST_HOUR=9
TIMEZONE=America/Los_Angeles
DIGEST_SILENT=1
# Optional: only alert immediately for dates before this one (YYYY-MM-DD), e.g. your
# currently booked appointment or the last date that still works. Empty = any sooner date.
# Alerts then say how many days before this date the new one is (without it: how much sooner
# than at the previous check).
# This is the default; each Telegram chat can set its own with /set_alert_before.
ALERT_ONLY_BEFORE=

# --- Guard rails ---------------------------------------------------------------
# Refuse to check more often than this, even if cron fires more often.
MIN_INTERVAL_MINUTES=30
# Pause this long after an empty answer or HTTP 403/429 (the site may be throttling).
BACKOFF_HOURS=3
# Alert after this many failed checks in a row.
ERROR_ALERT_AFTER=3

# --- Schedule --------------------------------------------------------------------
# When the Pi runs a check: the five crontab time fields (minute hour day month weekday),
# in the Pi's time zone (Europe/London). `make push-config` updates the cron entry when cron
# is on; `make cron-on` / `make cron-off` switch it. Examples:
#   17 * * * *          hourly at :17 (default)
#   17,47 * * * *       every 30 minutes (keep MIN_INTERVAL_MINUTES at 30 or less)
#   17 7-23 * * *       hourly, 07:00-23:59 only
# Runs closer together than MIN_INTERVAL_MINUTES are skipped without a request.
CRON_SCHEDULE=17 * * * *

# Use the same User-Agent as the browser you signed in with
# (browser DevTools console: navigator.userAgent). Empty = a generic Chrome string.
# The site seems to reject a session sent with another browser version. Sessions sent by the
# Chrome extension or the renewal page carry their own browser's, so this is for `make set-cookie`.
USER_AGENT=

# --- Renewing the session -------------------------------------------------------
# Visa-site sessions last about an hour. A small page on the Pi takes a fresh _yatri_session,
# either from the Chrome extension in extension/ (one click after you sign in) or pasted by hand,
# and runs a check. The "session ended" alert links to it. `make renew-token` fills in both values
# below and copies the token for the extension. Empty RENEW_URL = off.
# Home network only: never forward this port to the internet (the page is plain http).
RENEW_URL=
# Shared secret the extension sends to the Pi. `make renew-token` makes a new one.
RENEW_TOKEN=

# --- Files ---------------------------------------------------------------------
# Where state.json and cookies.json live. Empty = ~/.local/state/slot-machine
STATE_DIR=
